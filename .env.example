# ---------------------------------------------------------------------------
# Copy to .env and fill in your credentials:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Huawei Cloud authentication (required by memory / identity control plane) ---
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
HUAWEICLOUD_SDK_REGION=cn-southwest-2
VERIFY_SSL=true

# --- LLM (OpenAI-compatible endpoint) ---
# Huawei Cloud MaaS (ModelArts Studio) exposes an OpenAI-compatible endpoint.
# The console's official curl form is https://api.modelarts-maas.com/v2/chat/completions;
# a trailing /chat/completions is stripped automatically, so .../v2 also works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.modelarts-maas.com/v2/chat/completions
OPENAI_MODEL_NAME=glm-5.2
# Set to true when the model endpoint can only be reached through a system proxy
AGENTARTS_DEMO_LLM_TRUST_ENV=false
AGENTARTS_DEMO_LLM_TIMEOUT=120

# --- Memory service (written automatically by: uv run python -m demo.bootstrap memory) ---
AGENTARTS_MEMORY_SPACE_ID=
HUAWEICLOUD_SDK_MEMORY_API_KEY=
AGENTARTS_MEMORY_SPACE_NAME=langgraph-agentarts-demo-space

# --- Code interpreter sandbox ---
# AGENTARTS_CODE_INTERPRETER_AUTH_TYPE: API_KEY (needs the API key below) or IAM (AK/SK signing, no API key)
AGENTARTS_CODE_INTERPRETER_AUTH_TYPE=API_KEY
AGENTARTS_CODE_INTERPRETER_NAME=
HUAWEICLOUD_SDK_CODE_INTERPRETER_API_KEY=
# Data plane endpoint of the interpreter, i.e. its "access endpoint" from the console
AGENTARTS_CODEINTERPRETER_DATA_ENDPOINT=

# true: use Runtime for execute_python; false: use Code Interpreter
RUNTIME_AS_SANDBOX_TOOL=false
AGENTARTS_RUNTIME_AGENT_NAME=
AGENTARTS_RUNTIME_DATA_ENDPOINT=

# --- Agent Identity (written automatically by: uv run python -m demo.bootstrap identity) ---
AGENTARTS_IDENTITY_WORKLOAD_NAME=
AGENTARTS_IDENTITY_API_KEY_PROVIDER=
AGENTARTS_IDENTITY_SEED_API_KEY=
AGENTARTS_IDENTITY_USER_ID=demo-user

# --- Agent behaviour ---
AGENTARTS_DEMO_ACTOR_ID=demo-user
AGENTARTS_DEMO_ASSISTANT_ID=langgraph-agentarts-demo
AGENTARTS_DEMO_RECALL_ENABLED=true
AGENTARTS_DEMO_RECALL_TOP_K=3

# --- Runtime ---
# 0.0.0.0 so a container port mapping works; use 127.0.0.1 to listen locally only
AGENTARTS_DEMO_HOST=0.0.0.0
AGENTARTS_DEMO_PORT=8080
AGENTARTS_LOG_LEVEL=INFO
